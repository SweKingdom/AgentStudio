{
  "name": "@arm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/exit-reporter.mjs --test-reporter-destination=stderr \"test/**/*.test.ts\"",
    "doctor": "node --no-warnings --import tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@anthropic-ai/sdk": "^0.133.0",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "multer": "^2.4.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
